# CreditCore API — copy to .env, never commit real values

ENVIRONMENT=development
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
DEBUG=true

# --- Database -------------------------------------------------------------
# Local Postgres (default):
DATABASE_URL=postgresql+asyncpg://creditcore:password@localhost:5432/creditcore_dev
#
# Managed Postgres (Neon / Supabase / RDS): paste the provider's connection string here.
# You can paste it verbatim — the app forces the async driver, handles TLS, and strips
# params asyncpg can't read (sslmode, channel_binding). Prefer the DIRECT (non-pooled)
# host for the API server; the -pooler host is for serverless. Example (Neon):
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.eu-west-2.aws.neon.tech/neondb?sslmode=require

AWS_REGION=eu-west-1
AWS_ACCOUNT_ID=

JWT_SECRET_KEY=change-me
JWT_ALGORITHM=RS256
OIDC_ISSUER=https://your-idp.example.com

DATA_ENCRYPTION_KEY=change-me-32-bytes-aes256

LOG_LEVEL=INFO
SENTRY_DSN=

CCR_API_URL=
OPEN_BANKING_AGGREGATOR_URL=
