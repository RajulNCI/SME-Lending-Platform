# CreditCore API — copy to .env, fill in real values, never commit .env

ENVIRONMENT=development
DEBUG=true
SECRET_KEY=generate-with-openssl-rand-hex-32
LOG_LEVEL=INFO

# ── Database (RDS) ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_DB_PASSWORD@YOUR_RDS_ENDPOINT:5432/creditcore

# ── Cognito ───────────────────────────────────────────────────────────────────
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_CLIENT_ID=your_cognito_client_id
COGNITO_REGION=us-east-1
JWT_SECRET_KEY=generate-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256

# ── AWS ───────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_S3_DOCUMENTS_BUCKET=creditcore-documents-dev
AWS_S3_MODELS_BUCKET=creditcore-ai-models-dev
AWS_SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/ACCOUNT_ID/creditcore-processing-dev

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
