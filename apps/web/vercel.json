{
  "buildCommand": "cd ../.. && pnpm turbo run build --filter=@sme-lending-platform/web",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://tvuegpy2w7.execute-api.us-east-1.amazonaws.com/prod/api/$1"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
